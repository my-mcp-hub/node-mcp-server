{
  "name": "@my-mcp-hub/node-mcp-server",
  "version": "0.1.0",
  "description": "MCP Server Template For Node.js",
  "author": "zhensherlock",
  "type": "module",
  "license": "MIT",
  "bin": {
    "node-mcp-server": "./build/index.js"
  },
  "files": [
    "build",
    ".env.example",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf build coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "build": "npm run typecheck && cross-env NODE_ENV=production node scripts/build.js",
    "dev": "npm run dev:stdio",
    "dev:stdio": "cross-env NODE_ENV=local concurrently \"tsc --noEmit --watch\" \"node scripts/dev.js\"",
    "dev:web": "cross-env NODE_ENV=local TRANSPORT=web concurrently \"tsc --noEmit --watch\" \"node scripts/dev.js\"",
    "test": "vitest run",
    "report": "c8 report --reporter=lcov --reporter=html",
    "coverage": "rimraf coverage && npm run test && npm run report",
    "check": "npm run lint && npm run build && npm run coverage",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 1 -n changelog-option.js",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/inspector": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "compare-func": "^2.0.0",
    "concurrently": "^10.0.4",
    "conventional-changelog-angular": "^9.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "glob": "^13.0.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tree-kill": "^1.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-mcp-hub/node-mcp-server.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.9",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
